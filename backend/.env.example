# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Database
# SQLite works out of the box (a file is created next to where you run the server).
# Postgres also works: postgresql://user:password@localhost:5432/dbname (install psycopg2-binary)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./app.db

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API  (https://developers.facebook.com/apps -> your app -> WhatsApp -> API Setup)
# ---------------------------------------------------------------------------
# Temporary access token (valid ~24h) or a permanent System User token
WHATSAPP_TOKEN=your_whatsapp_access_token
# "Phone number ID" shown under the "From" number in API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Any string you invent. You type the same string into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string
# Optional but recommended: App Secret (App settings -> Basic). When set, the server rejects
# webhook calls that Meta did not sign.
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# LLM providers. Set at least one. Order tried: Groq -> Gemini main model -> Gemini fallback model.
# Free tiers have small quotas, so having two providers keeps the bot answering.
# ---------------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.5-flash-lite

# ---------------------------------------------------------------------------
# Semantic memory (RAG) with Pinecone. Optional: without it the AI still replies
# using your style profile and recent messages, but cannot search your old chats.
# Create an index with integrated embeddings (e.g. llama-text-embed-v2, field map text=text)
# at https://app.pinecone.io
# ---------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# ---------------------------------------------------------------------------
# Personality
# ---------------------------------------------------------------------------
# Your first name. The AI replies AS this person and understands "<name>" in a message to mean itself.
OWNER_NAME=YourName
AI_TONE=casual
AI_LANGUAGE=Hinglish
